# Copy to .env.production on the production host; never commit the filled file.
COMPOSE_PROJECT_NAME=alphazee-prod
IMAGE_TAG=local
SITE_DOMAIN=store.example.com
POSTGRES_USER=alphazee
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD
POSTGRES_DB=alphazee
# URL-encode any special characters in the password portion of DATABASE_URL.
DATABASE_URL=postgresql://alphazee:REPLACE_WITH_LONG_RANDOM_URL_SAFE_PASSWORD@db:5432/alphazee
# Optional: real bank details are needed before transfer becomes available.
BANK_NAME=
BANK_ACCOUNT_TITLE=
BANK_ACCOUNT_NUMBER=
BANK_IBAN=
