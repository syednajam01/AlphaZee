# Backend environment — copy to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://alphazee:changeme@localhost:5433/alphazee_dev

# Application environment: development | production
APP_ENV=development

# Enable verbose debug logging and /docs UI
DEBUG=true

# Comma-separated allowed CORS origins (development defaults shown)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
