# Backend environment — copy to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://alphazee:changeme@localhost:5433/alphazee_dev

# Application environment: development | production
APP_ENV=development

# Public checkout stays closed. True is accepted only with APP_ENV=test and
# a loopback PostgreSQL database ending in _test (never alphazee_dev).
TEST_CHECKOUT_ENABLED=false

# Enable verbose debug logging and /docs UI
DEBUG=true

# Comma-separated allowed CORS origins (development defaults shown)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:3000

# Owner access uses a provisioned database credential and an HttpOnly session.
# Run: python scripts/provision_owner.py YOUR_USERNAME (interactive password prompt).
# ADMIN_API_KEY, OWNER_PASSWORD and SESSION_SECRET_KEY are not login credentials.
SESSION_MAX_AGE_SECONDS=28800

# Bank transfer settings for customer checkout
BANK_NAME="Meezan Bank Ltd."
BANK_ACCOUNT_TITLE="AlphaZee Private Limited"
BANK_ACCOUNT_NUMBER="PENDING_CONFIGURATION"
BANK_IBAN="PENDING_IBAN_CONFIGURATION"

