# Backend environment — copy to .env and fill in real values.
# Never commit .env to version control.

# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://alphazee:changeme@localhost:5433/alphazee_dev

# Application environment: development | production
APP_ENV=development

# Enable verbose debug logging and /docs UI
DEBUG=true

# Comma-separated allowed CORS origins (development defaults shown)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Secret key required to access privileged owner admin endpoints (/api/v1/admin/*)
# In production, must be at least 32 random characters (e.g. openssl rand -hex 24)
ADMIN_API_KEY=alphazee-dev-admin-key-change-in-prod

# Bank transfer settings for customer checkout
BANK_NAME="Meezan Bank Ltd."
BANK_ACCOUNT_TITLE="AlphaZee Private Limited"
BANK_ACCOUNT_NUMBER="PENDING_CONFIGURATION"
BANK_IBAN="PENDING_IBAN_CONFIGURATION"

